# Server
PORT=5173
HOST=127.0.0.1

# OpenAI Responses API
# If missing, OfferOS uses deterministic local mock answers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Box API
# Use a developer token for local hackathon/demo work, or replace the adapter
# with OAuth/JWT for production.
BOX_DEVELOPER_TOKEN=
BOX_COMMON_FOLDER_ID=
BOX_CANDIDATES_FOLDER_ID=

# Apify
# Actor input receives the candidate object.
APIFY_TOKEN=
APIFY_ACTOR_ID=

# Optional HR notification webhook.
# Any endpoint that accepts JSON can be used here.
NOTIFY_WEBHOOK_URL=

# Optional override for local writable JSON DB.
OFFEROS_DB_PATH=
